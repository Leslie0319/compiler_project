#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "utils.h"
#include "semantic.c" // 包含语义执行逻辑
#include "lexer_manual.c" // 调用词法分析器提供的 `get_next_token` 等接口

Token current_token;

// 预读下一个 token
void advance() {
    current_token = get_next_token();
}

// 匹配指定类型 token，否则报错
void match(TokenType expected) {
    if (current_token.type == expected) {
        advance();
    } else {
        error("Syntax Error: unexpected token", current_token.line);
        exit(1);
    }
}

// <script> ::= { <statement> }
void parse_script() {
    while (current_token.type != TOKEN_EOF) {
        parse_statement();
    }
}

// <statement> ::= <file_op> | <dir_op> | <copy_op> | <delete_op> | <if_stmt> | <help_stmt>
void parse_statement() {
    switch (current_token.type) {
        case TOKEN_KEYWORD_OPEN:
        case TOKEN_KEYWORD_READ:
        case TOKEN_KEYWORD_WRITE:
            parse_file_op(); break;
        case TOKEN_KEYWORD_CD:
        case TOKEN_KEYWORD_LS:
        case TOKEN_KEYWORD_MKDIR:
        case TOKEN_KEYWORD_RMDIR:
            parse_dir_op(); break;
        case TOKEN_KEYWORD_COPY:
        case TOKEN_KEYWORD_MOVE:
            parse_copy_op(); break;
        case TOKEN_KEYWORD_DELETE:
            parse_delete_op(); break;
        case TOKEN_KEYWORD_IF:
            parse_if_stmt(); break;
        case TOKEN_KEYWORD_HELP:
            parse_help_stmt(); break;
        default:
            error("Syntax Error: unknown statement", current_token.line);
            advance(); break;
    }
}

// <file_op> ::= 'open' <filename> | 'read' <filename> | 'write' <filename> <string>
void parse_file_op() {
    if (current_token.type == TOKEN_KEYWORD_OPEN) {
        advance();
        char *filename = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        sem_open(filename);
    } else if (current_token.type == TOKEN_KEYWORD_READ) {
        advance();
        char *filename = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        sem_read(filename);
    } else if (current_token.type == TOKEN_KEYWORD_WRITE) {
        advance();
        char *filename = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        char *content = current_token.lexeme;
        match(TOKEN_STRING);
        sem_write(filename, content);
    }
}

// <dir_op> ::= 'cd' <path> | 'ls' | 'mkdir' <path> | 'rmdir' <path>
void parse_dir_op() {
    if (current_token.type == TOKEN_KEYWORD_CD) {
        advance();
        char *path = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        sem_cd(path);
    } else if (current_token.type == TOKEN_KEYWORD_LS) {
        advance();
        sem_ls();
    } else if (current_token.type == TOKEN_KEYWORD_MKDIR) {
        advance();
        char *path = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        sem_mkdir(path);
    } else if (current_token.type == TOKEN_KEYWORD_RMDIR) {
        advance();
        char *path = current_token.lexeme;
        match(TOKEN_IDENTIFIER);
        sem_rmdir(path);
    }
}

// <copy_op> ::= 'copy' <src> <dst> | 'move' <src> <dst>
void parse_copy_op() {
    TokenType op_type = current_token.type;
    advance();
    char *src = current_token.lexeme;
    match(TOKEN_IDENTIFIER);
    char *dst = current_token.lexeme;
    match(TOKEN_IDENTIFIER);
    if (op_type == TOKEN_KEYWORD_COPY) {
        sem_copy(src, dst);
    } else {
        sem_move(src, dst);
    }
}

// <delete_op> ::= 'delete' <target>
void parse_delete_op() {
    match(TOKEN_KEYWORD_DELETE);
    char *target = current_token.lexeme;
    match(TOKEN_IDENTIFIER);
    sem_delete(target);
}

// <if_stmt> ::= 'if' <condition> 'then' <statement>
void parse_if_stmt() {
    match(TOKEN_KEYWORD_IF);
    char *cond = current_token.lexeme;
    match(TOKEN_IDENTIFIER);
    match(TOKEN_KEYWORD_THEN);
    if (sem_condition(cond)) {
        parse_statement();
    }
}

// <help_stmt> ::= 'help'
void parse_help_stmt() {
    match(TOKEN_KEYWORD_HELP);
    sem_help();
}

// 主程序
int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <script_file>\n", argv[0]);
        return 1;
    }

    init_lexer(argv[1]);
    advance(); // 初始化第一个 token
    parse_script();
    printf("Parsing completed successfully.\n");
    return 0;
}

✅ 功能说明：
递归下降语法分析：每个语法规则对应一个 parse_ 函数。

语义集成：每个语句在语法匹配后立即调用相应 sem_* 语义处理函数。

错误处理：通过 match() 和 error() 实现基本语法错误定位。

可扩展结构：便于添加更多操作语句（如权限管理等）。
