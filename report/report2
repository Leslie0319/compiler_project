lexer.l：LEX 词法定义文件
%{
#include "token.h"
#include <stdio.h>
#include <stdlib.h>
Token yylval;
%}

%%
"read"|"write"|"cd"|"mkdir"|"rm"|"cp"|"mv"|"chmod"|"help"  {
    yylval.type = T_KEYWORD;
    yylval.lexeme = strdup(yytext);
    return T_KEYWORD;
}
[a-zA-Z_][a-zA-Z0-9_]* {
    yylval.type = T_IDENTIFIER;
    yylval.lexeme = strdup(yytext);
    return T_IDENTIFIER;
}
[0-9]+ {
    yylval.type = T_INTEGER;
    yylval.lexeme = strdup(yytext);
    yylval.attr.int_val = atoi(yytext);
    return T_INTEGER;
}
\"([^"])*\" {
    yylval.type = T_STRING;
    yylval.lexeme = strdup(yytext);
    yylval.attr.str_val = strdup(yytext);
    return T_STRING;
}
. {
    yylval.type = T_SYMBOL;
    yylval.lexeme = strdup(yytext);
    return T_SYMBOL;
}
[ \t\r\n]+ ;
%%

int yywrap() { return 1; }
