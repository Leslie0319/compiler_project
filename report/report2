lexer.c：手工实现词法分析器
#include "lexer.h"
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_LEXEME_LEN 128

static FILE* in;
static int line = 1, col = 0;
static int current_char;

void init_lexer(FILE* input) {
    in = input;
    current_char = fgetc(in);
}

static void advance() {
    if (current_char == '\n') {
        line++;
        col = 0;
    } else {
        col++;
    }
    current_char = fgetc(in);
}

static int is_keyword(const char* str) {
    const char* keywords[] = {
        "read", "write", "cd", "mkdir", "rm", "cp", "mv", "chmod", "help", NULL
    };
    for (int i = 0; keywords[i]; i++) {
        if (strcmp(str, keywords[i]) == 0)
            return 1;
    }
    return 0;
}

Token get_next_token() {
    Token tok;
    tok.line = line;
    tok.column = col;

    // Skip whitespace
    while (isspace(current_char)) advance();

    if (current_char == EOF) {
        tok.type = T_EOF;
        tok.lexeme = strdup("EOF");
        return tok;
    }

    if (isalpha(current_char) || current_char == '_') {
        char buffer[MAX_LEXEME_LEN];
        int len = 0;
        while (isalnum(current_char) || current_char == '_') {
            buffer[len++] = current_char;
            advance();
        }
        buffer[len] = '\0';
        tok.lexeme = strdup(buffer);
        if (is_keyword(buffer)) {
            tok.type = T_KEYWORD;
        } else {
            tok.type = T_IDENTIFIER;
        }
        tok.attr.str_val = strdup(buffer);
        return tok;
    }

    if (isdigit(current_char)) {
        char buffer[MAX_LEXEME_LEN];
        int len = 0;
        while (isdigit(current_char)) {
            buffer[len++] = current_char;
            advance();
        }
        buffer[len] = '\0';
        tok.type = T_INTEGER;
        tok.lexeme = strdup(buffer);
        tok.attr.int_val = atoi(buffer);
        return tok;
    }

    if (current_char == '"') {
        advance();  // skip opening quote
        char buffer[MAX_LEXEME_LEN];
        int len = 0;
        while (current_char != '"' && current_char != EOF) {
            buffer[len++] = current_char;
            advance();
        }
        buffer[len] = '\0';
        if (current_char == '"') advance();  // skip closing quote
        tok.type = T_STRING;
        tok.lexeme = strdup(buffer);
        tok.attr.str_val = strdup(buffer);
        return tok;
    }

    // Handle symbols
    char sym[2] = { current_char, '\0' };
    tok.type = T_SYMBOL;
    tok.lexeme = strdup(sym);
    advance();
    return tok;
}

void free_token(Token tok) {
    free(tok.lexeme);
    if (tok.type == T_IDENTIFIER || tok.type == T_STRING)
        free(tok.attr.str_val);
}

main.c：测试词法分析器
#include "lexer.h"
#include <stdio.h>

int main() {
    FILE* fp = fopen("test.txt", "r");
    if (!fp) {
        perror("File open failed");
        return 1;
    }

    init_lexer(fp);
    Token tok;
    do {
        tok = get_next_token();
        printf("Token: Type=%d, Lexeme='%s', Line=%d, Col=%d\n",
               tok.type, tok.lexeme, tok.line, tok.column);
        free_token(tok);
    } while (tok.type != T_EOF);

    fclose(fp);
    return 0;
}

