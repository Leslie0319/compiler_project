五、LEX实现词法分析器
1. LEX代码（lex.l）
%{
#include "y.tab.h"
#include <string.h>
%}

%%
[ \t\n\r]+              ;  // 忽略空白
"read"                 { return READ; }
"write"                { return WRITE; }
"cd"                   { return CD; }
"ls"                   { return LS; }
"mkdir"                { return MKDIR; }
"rmdir"                { return RMDIR; }
"rename"               { return RENAME; }
"copy"                 { return COPY; }
"move"                 { return MOVE; }
"delete"               { return DELETE; }
"try"                  { return TRY; }
"catch"                { return CATCH; }
"end"                  { return END; }
"help"                 { return HELP; }

[0-9]+                 { yylval.ival = atoi(yytext); return INTEGER; }
\"([^\\\"]|\\.)*\"     { yylval.str = strdup(yytext); return STRING; }
[a-zA-Z_][a-zA-Z0-9_]* { yylval.str = strdup(yytext); return IDENTIFIER; }
"="|";"|","|"{"|"}"    { return yytext[0]; }

.                      { printf("非法字符: %s\n", yytext); return ERROR; }
%%

int yywrap() { return 1; }

