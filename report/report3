2.使用 YACC 构建语法分析器
文件结构
yacc_parser/
├── parser.y
├── lexer.l
├── token.h
├── test.txt

parser.y：YACC 文件
%{
#include <stdio.h>
#include <stdlib.h>
%}

%token READ WRITE CD MKDIR RM CP MV CHMOD HELP STRING

%%
program:
    | program command
    ;

command:
      READ STRING           { printf("Read command\n"); }
    | WRITE STRING          { printf("Write command\n"); }
    | CD STRING             { printf("Change directory\n"); }
    | MKDIR STRING          { printf("Make directory\n"); }
    | RM STRING             { printf("Remove file\n"); }
    | CP STRING STRING      { printf("Copy file\n"); }
    | MV STRING STRING      { printf("Move file\n"); }
    | CHMOD STRING STRING   { printf("Change permissions\n"); }
    | HELP                  { printf("Help\n"); }
    ;
%%

int main() {
    return yyparse();
}

int yyerror(char* s) {
    fprintf(stderr, "Syntax Error: %s\n", s);
    return 0;
}

lexer.l：对应词法文件（匹配 yacc）
%{
#include "y.tab.h"
%}

%%
"read"     { return READ; }
"write"    { return WRITE; }
"cd"       { return CD; }
"mkdir"    { return MKDIR; }
"rm"       { return RM; }
"cp"       { return CP; }
"mv"       { return MV; }
"chmod"    { return CHMOD; }
"help"     { return HELP; }
\"[^\"]+\" { yylval = strdup(yytext); return STRING; }
[ \t\r\n]+ ;
.          { return yytext[0]; }
%%

编译命令
bison -d parser.y
flex lexer.l
gcc parser.tab.c lex.yy.c -o parser -lfl
