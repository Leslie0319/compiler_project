1.手工实现语法分析器（递归下降法，C语言）
数据结构
typedef enum {
    NT_PROGRAM,
    NT_COMMAND,
    NT_READ,
    NT_WRITE,
    NT_CD,
    NT_MKDIR,
    NT_RM,
    NT_CP,
    NT_MV,
    NT_CHMOD,
    NT_HELP
} NonTerminal;

typedef struct {
    Token current_token;
    // 词法分析器接口
    Token (*get_next_token)();
} Parser;

函数声明
void parse_program(Parser* parser);
void parse_command(Parser* parser);
void match(Parser* parser, TokenType expected_type, const char* expected_lexeme);

解析流程主函数
void parse_program(Parser* parser) {
    while (parser->current_token.type != T_EOF) {
        parse_command(parser);
    }
}	

command 解析函数（主分发）
void parse_command(Parser* parser) {
    if (strcmp(parser->current_token.lexeme, "read") == 0) {
        match(parser, T_KEYWORD, "read");
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "write") == 0) {
        match(parser, T_KEYWORD, "write");
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "cd") == 0) {
        match(parser, T_KEYWORD, "cd");
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "mkdir") == 0) {
        match(parser, T_KEYWORD, "mkdir");
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "rm") == 0) {
        match(parser, T_KEYWORD, "rm");
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "cp") == 0) {
        match(parser, T_KEYWORD, "cp");
        match(parser, T_STRING, NULL);
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "mv") == 0) {
        match(parser, T_KEYWORD, "mv");
        match(parser, T_STRING, NULL);
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "chmod") == 0) {
        match(parser, T_KEYWORD, "chmod");
        match(parser, T_STRING, NULL);
        match(parser, T_STRING, NULL);
    } else if (strcmp(parser->current_token.lexeme, "help") == 0) {
        match(parser, T_KEYWORD, "help");
    } else {
        fprintf(stderr, "Syntax error at line %d: unknown command '%s'\n",
                parser->current_token.line, parser->current_token.lexeme);
        exit(1);
    }
}

match 函数
void match(Parser* parser, TokenType expected_type, const char* expected_lexeme) {
    if (parser->current_token.type != expected_type) {
        fprintf(stderr, "Syntax error: expected type %d, got %d\n",
                expected_type, parser->current_token.type);
        exit(1);
    }
    if (expected_lexeme != NULL &&
        strcmp(parser->current_token.lexeme, expected_lexeme) != 0) {
        fprintf(stderr, "Syntax error: expected '%s', got '%s'\n",
                expected_lexeme, parser->current_token.lexeme);
        exit(1);
    }

    parser->current_token = parser->get_next_token();
}
